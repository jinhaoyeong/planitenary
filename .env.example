VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key
VITE_SUPABASE_AUTH_REDIRECT_URL=http://localhost:5173/

# Optional preview-only flag. Handbook capture (?handbookQa / ?visualQa) is
# always available in `npm run dev`. Set this to enable those routes in a
# non-dev preview build. Production should leave this unset/false so those
# query params are ignored and the normal app flow continues.
# VITE_ENABLE_HANDBOOK_QA=true

# ---------------------------------------------------------------------------
# The reasoning tier — the only part of this app that can generate a bill.
#
# These are Edge Function secrets, NOT VITE_ variables: a model key must never
# reach the browser. Set them with `supabase secrets set`, not in this file.
# Everything below is optional; with no key set, the app runs exactly as it
# does today and cards keep their deterministic rationale.
# ---------------------------------------------------------------------------

# Which provider to call. `openai` (default) or `gemini`. Chosen explicitly —
# there is deliberately no failover, so an outage or an exhausted budget on one
# provider never starts spending at the other.
# TRAVEL_REASONING_PROVIDER=openai

# OPENAI_API_KEY=sk-...

# Defaults to gpt-5-nano: $0.05/1M input, $0.40/1M output — the cheapest model
# OpenAI publishes, and both operations here are extraction rather than
# judgement, so nothing stronger is warranted.
# OPENAI_MODEL=gpt-5-nano

# Defaults to `minimal`. NOT `none`: gpt-5-nano rejects `none` outright while
# gpt-5.4-nano accepts and defaults to it, and a wrong value is an opaque 400.
# Only set `none` if you have pinned OPENAI_MODEL to a model that takes it.
# OPENAI_REASONING_EFFORT=minimal

# Calls per day, across every function, for whichever provider is selected.
# Deliberately low: a misconfiguration should be cheap to discover. At the
# gpt-5-nano default, 50 calls is well under one US cent.
# AI_DAILY_CALL_LIMIT=50

# The spending ceiling for the current prepaid budget, in USD. Deliberately
# below the balance actually loaded — a provider's prepaid cutoff is not
# instantaneous, and the gap separates "the AI stopped" from "the account is
# empty and everything else paid stopped too". $5 loaded, $4.25 ceiling.
# AI_BUDGET_USD=4.25

# When the current budget started counting. UNSET MEANS "EVERYTHING EVER",
# which is the correct default for a prepaid balance: money already spent does
# not become unspent because time passed.
#
# This is deliberately NOT a rolling window. Summing only the last N days lets
# old spending age out, so the ceiling silently refills itself and a prepaid $5
# can be spent more than once. Set this ONLY when you have deliberately topped
# the balance up and want a fresh budget to start counting from that moment.
# AI_BUDGET_STARTED_AT=2026-08-11T00:00:00Z

# The retained Gemini adapter. Inactive unless TRAVEL_REASONING_PROVIDER=gemini.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
